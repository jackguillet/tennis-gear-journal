{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?path=:path*"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/oauth?op=resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth?op=resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api/oauth?op=server"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth?op=server"
    },
    {
      "source": "/oauth/:op",
      "destination": "/api/oauth?op=:op"
    },
    {
      "source": "/api/mcp/:token",
      "destination": "/api/mcp?token=:token"
    },
    {
      "source": "/api/calendar/:token",
      "destination": "/api/calendar?token=:token"
    },
    {
      "source": "/api/log/:token",
      "destination": "/api/log?token=:token"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(), geolocation=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/reminders",
      "schedule": "0 17 * * *"
    }
  ]
}
