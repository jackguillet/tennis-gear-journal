# Written by `neon deploy` / `neon env pull` into .env.local:
DATABASE_URL=            # Neon pooled connection string (app traffic)
DATABASE_URL_UNPOOLED=   # direct connection (npm run db:migrate)
NEON_AUTH_BASE_URL=      # this branch's Neon Auth URL

# Yours to set, locally and in Vercel:
NEON_AUTH_COOKIE_SECRET= # openssl rand -base64 32
OWNER_EMAIL=             # optional: your email, to claim rackets saved by the passcode version
