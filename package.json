{
  "name": "tennis-gear-journal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Tennis Hub (formerly Stringbed Meter): log play, track strings and shoes, book courts and measure tennis string-bed tension from the sound of a tap. Accounts with Neon Auth, data in Neon Postgres, hosted on Vercel.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.js",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && node scripts/build.js",
    "typecheck": "tsc -p web",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "test": "node --test test/*.test.js",
    "test:screens": "node --test test/screens/*.test.js"
  },
  "dependencies": {
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@neondatabase/auth": "0.6.0-beta",
    "@vercel/functions": "3.9.11",
    "pg": "8.23.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vaul": "^1.1.2",
    "vite": "^8.3.8"
  }
}
