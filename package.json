{
  "name": "tennis-gear-journal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Tennis Hub (formerly Stringbed Meter): log play, track strings and shoes, book courts and measure tennis string-bed tension from the sound of a tap. Accounts with Neon Auth, data in Neon Postgres, hosted on Vercel.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.js",
    "build": "node scripts/build.js",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@neondatabase/auth": "0.6.0-beta",
    "@vercel/functions": "3.9.11",
    "pg": "8.23.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "better-auth": "1.7.6"
  }
}
